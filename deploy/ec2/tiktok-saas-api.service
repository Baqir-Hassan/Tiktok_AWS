[Unit]
Description=TikTok SaaS FastAPI API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/tiktok-saas/backend
EnvironmentFile=/opt/tiktok-saas/backend/.env
ExecStart=/opt/tiktok-saas/backend/.venv/bin/gunicorn -c gunicorn.conf.py app.main:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
