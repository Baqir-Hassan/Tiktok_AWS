APP_NAME=TikTok SaaS Backend
ENVIRONMENT=production
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

DATABASE_URL=postgresql+psycopg://app_user:app_password@your-rds-endpoint:5432/tiktok_saas

INITIAL_USER_CREDITS=5
JOB_COST_CREDITS=1
JOB_RATE_LIMIT_COUNT=5
JOB_RATE_LIMIT_WINDOW_SECONDS=3600
MAX_JOB_RETRIES=3
WORKER_API_KEY=replace-this-worker-key
WORKER_STALE_TIMEOUT_MINUTES=15

STORAGE_BACKEND=s3
PUBLIC_MEDIA_BASE_URL=
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-video-output-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=tiktok-saas/1.0

TTS_PROVIDER_DEFAULT=piper
PIPER_BINARY=piper
PIPER_MODEL_PATH=/opt/piper/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=/opt/piper/en_US-lessac-medium.onnx.json

WHISPER_MODEL_SIZE=base
MINECRAFT_CLIP_PATH=/opt/tiktok-saas/assets/minecraft_loop.mp4
TIKTOK_HANDLE=@YourHandle
FFMPEG_THREADS=2
