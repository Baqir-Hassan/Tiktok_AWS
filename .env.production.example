APP_NAME=Sage Studio Backend
APP_DISPLAY_NAME=Sage Studio
API_V1_PREFIX=/api/v1
ENVIRONMENT=production

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MEDIA_ACCESS_TOKEN_EXPIRE_SECONDS=300
VERIFICATION_TOKEN_EXPIRE_MINUTES=60
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
JWT_ALGORITHM=HS256

DATABASE_URL=postgresql+psycopg://app_user:app_password@your-rds-endpoint:5432/tiktok_saas
QUEUE_PROVIDER=database

INITIAL_USER_CREDITS=5
JOB_COST_CREDITS=1
JOB_RATE_LIMIT_COUNT=5
JOB_RATE_LIMIT_WINDOW_SECONDS=3600
WORKER_POLL_INTERVAL_SECONDS=10
MAX_JOB_RETRIES=3
WORKER_API_KEY=replace-with-a-worker-api-key
WORKER_STALE_TIMEOUT_MINUTES=15

CORS_ALLOW_ORIGINS=https://studio.yourdomain.com
AUTH_LOGIN_RATE_LIMIT_COUNT=10
AUTH_REGISTER_RATE_LIMIT_COUNT=5
AUTH_EMAIL_RATE_LIMIT_COUNT=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
VERIFY_EMAIL_PAGE_URL=https://studio.yourdomain.com/verify-email
RESET_PASSWORD_PAGE_URL=https://studio.yourdomain.com/reset-password

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM_EMAIL=your-email@example.com

STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=/opt/sage-studio/storage/videos

AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=
S3_BUCKET_NAME=your-video-output-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=sage-studio/1.0

TTS_PROVIDER_DEFAULT=edge
PIPER_BINARY=piper
PIPER_MODEL_PATH=/opt/piper/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=/opt/piper/en_US-lessac-medium.onnx.json
PIPER_SPEAKER_ID=
PIPER_NOISE_SCALE=0.667
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_W=0.8

EDGE_TTS_VOICE=en-US-SteffanNeural
EDGE_TTS_VOICE_MALE=en-US-SteffanNeural
EDGE_TTS_VOICE_FEMALE=en-US-AvaNeural
EDGE_TTS_USE_GEMINI_GENDER_DETECTION=false
EDGE_TTS_GENDER_MODEL=llama-3.3-70b-versatile
EDGE_TTS_RATE=+15%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_MAX_RETRIES=3

WHISPER_MODEL_SIZE=base
MINECRAFT_CLIP_PATH=/opt/sage-studio/assets/minecraft_loop.mp4
TIKTOK_HANDLE=@YourHandle
FFMPEG_THREADS=2

RENDER_BACKEND=moviepy
RENDER_VIDEO_CODEC=libx264
RENDER_AUDIO_CODEC=aac
RENDER_PRESET=ultrafast
RENDER_AMF_USAGE=transcoding
RENDER_AMF_QUALITY=balanced
RENDER_VIDEO_BITRATE=5M
RENDER_VIDEO_MAXRATE=6M
RENDER_VIDEO_BUFSIZE=10M

TITLE_FONT_PATH=
SUBTITLE_FONT_PATH=
HANDLE_FONT_PATH=
TITLE_FONT_SIZE=55
HANDLE_FONT_SIZE=32
SUBTITLE_FONT_SIZE=80
SUBTITLE_STROKE_WIDTH=4
SUBTITLE_WORDS_PER_CHUNK=3
SUBTITLE_VERTICAL_MARGIN=400
